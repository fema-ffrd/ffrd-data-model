erDiagram
    %% Derived tables are materialized from source Iceberg tables.
    %% They are NOT source-of-truth — they are read-optimized aggregations regenerated on demand.
    %% Each table notes: source tables, refresh trigger, partition/sort strategy, and user stories served.
    %% mv_peak_output_by_element
    %%   Source: output_ts
    %%   Grain: one row per (event_id, element_id, variable, run_id, run_version)
    %%   Refresh: after each run_catalog batch commit
    %%   Partition: bucket(512, event_id), variable
    %%   Sort: event_id, element_id, variable
    %%   Stories: 15 (obs vs modeled), 24 (HMS vs RAS flows), 28 (trace hazard contributors)
    %% mv_event_variable_stats
    %%   Source: output_ts
    %%   Grain: one row per (event_id, variable, run_type, run_version)
    %%   Refresh: after each run batch commit
    %%   Partition: bucket(512, event_id), variable
    %%   Sort: event_id, variable, run_type, run_version
    %%   Stories: 6 (event filtering stats), 32 (basin-level risk summary)
    %% mv_aep_frequency_stats
    %%   Source: output_ts joined to events (realization_id)
    %%   Grain: one row per (element_id, variable, aep_label, run_type)
    %%   Refresh: after full realization ensemble is committed
    %%   Partition: variable, aep_label
    %%   Sort: element_id, variable, aep_label
    %%   Stories: 28 (trace hazard result), 31 (uncertainty bounds), 32 (standard frequency risk)
    %% mv_gage_model_comparison
    %%   Source: output_ts joined to obs_ts via model_elements.gage_id
    %%   Grain: one row per (gage_id, event_id, variable, run_id)
    %%   Refresh: when obs_ts or output_ts are updated for co-located gages
    %%   Partition: bucket(256, gage_id), variable
    %%   Sort: gage_id, variable, event_id
    %%   Stories: 15 (observed vs computed comparison)
    %% mv_run_performance
    %%   Source: run_catalog joined to run_resources
    %%   Grain: one row per (run_id, model_id)
    %%   Refresh: after each run_catalog + run_resources write
    %%   Partition: run_type, status
    %%   Sort: model_id, started_at
    %%   Stories: 2 (reliability and performance), 3 (hotfix identification)
    %% mv_basin_cost_rollup
    %%   Source: run_resources joined to run_catalog and models
    %%   Grain: one row per (model_id, billing_month)
    %%   Refresh: daily or on-demand
    %%   Partition: billing_month
    %%   Sort: model_id, billing_month
    %%   Stories: 4 (basin cost, MTD spend, projected cost)
    %% mv_conformance_summary
    %%   Source: models.metadata_json (parsed) joined to run_catalog
    %%   Grain: one row per (model_id, model_version, check_name)
    %%   Refresh: when model metadata is updated after conformance gate review
    %%   Partition: model_id
    %%   Sort: model_id, model_version, check_name
    %%   Stories: 5 (conformance pass/fail per basin and check)

    output_ts ||--o{ mv_peak_output_by_element : "aggregated from"
    output_ts ||--o{ mv_event_variable_stats : "aggregated from"
    output_ts ||--o{ mv_aep_frequency_stats : "aggregated from"
    output_ts ||--o{ mv_gage_model_comparison : "modeled side"
    obs_ts ||--o{ mv_gage_model_comparison : "observed side"
    output_ts ||--o{ mv_run_performance : "via run_catalog"
    run_catalog ||--o{ mv_run_performance : "aggregated from"
    run_resources ||--o{ mv_run_performance : "cost + timing"
    run_resources ||--o{ mv_basin_cost_rollup : "aggregated from"
    run_catalog ||--o{ mv_basin_cost_rollup : "via model_id"
    models ||--o{ mv_conformance_summary : "metadata parsed from"

