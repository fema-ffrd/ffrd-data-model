erDiagram
    %% Logical identifiers (not enforced by Iceberg):
    %% models.model_id, model_elements.element_id, gages.gage_id, events.event_id
    %% Join intent: output_ts(event_id, element_id), obs_ts(gage_id, ts)
    %% Derived summary tables are materialized from output_ts and regenerated.
    %% They are lookup accelerators, not source-of-truth records.
    %% Run semantics for simulated outputs:
    %%  - run_id = immutable execution identifier; run_version = monotonic rerun number
    %% Iceberg design for output_ts:
    %%  - partition spec: bucket(512, event_id), run_type
    %%  - sort order: event_id, element_id, variable, ts
    %%  - rationale: optimize event + element full-series reads for 20k-200k events
    %% Iceberg design for obs_ts (historical observations):
    %%  - partition spec: bucket(256, gage_id), months(ts)
    %%  - sort order: gage_id, variable, ts
    %% Iceberg design for derived_event_variable_summary:
    %%  - partition spec: bucket(512, event_id), variable
    %%  - sort order: event_id, variable, run_type, run_version
    %% Iceberg design for derived_event_element_variable_summary:
    %%  - partition spec: bucket(512, event_id), variable
    %%  - sort order: event_id, element_id, variable, run_type, run_version
    %% output_grids_repo stores metadata pointers to Icechunk repositories/snapshots.
    %% output_grids_repo access pattern:
    %%  - partition spec: bucket(512, event_id), run_type
    %%  - sort order: event_id, element_id, variable, ts
    %%  - snapshot_ref semantics: immutable content-addressed snapshot id (preferred),
    %%    or stable tag/branch name resolved to a snapshot at read time.
    %% Table grain:
    %%  - output_ts: one row per event_id, element_id, variable, ts, run_id
    %%  - output_grids_repo: one row per event_id, element_id, variable, ts, run_id
    %%  - obs_ts: one row per gage_id, variable, ts

    gages |o--o{ model_elements : "gage mapping"
    structures |o--o{ model_elements : "dam / levee mapping"
    models ||--o{ model_elements : "contains element"
    events ||--o{ output_ts : "event output"
    model_elements ||--o{ output_ts : "element output"
    models ||--o{ output_ts : "denormalized model id"
    events ||--o{ output_grids_repo : "event output grids"
    events ||--o{ run_catalog : "run catalog lineage"
    model_elements ||--o{ output_grids_repo : "element output grids"
    models ||--o{ output_grids_repo : "denormalized model id"
    gages ||--o{ obs_ts : "gage observations"
    models ||--o{ model_event_files : "model artifacts"
    events ||--o{ model_event_files : "event artifacts"
    models ||--o{ run_catalog : "authoritative run metadata"

    run_catalog ||--o{ output_ts : "run lineage"
    run_catalog ||--o{ output_grids_repo : "run lineage"
