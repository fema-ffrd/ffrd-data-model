---
title: Grids
---

erDiagram
    %% Gridded (raster) data lives in long-lived Icechunk repositories,
    %% one per data domain. Each repo accumulates snapshots over time.
    %% grid_repos: catalog of the Icechunk repositories themselves.
    %% grids: catalog/pointer rows, one per variable per event (RAS/HMS,
    %%   merged across runs) or per storm (observed precip, pre-transposition).
    %% Exactly one of event_id or storm_id is populated per row:
    %%   - event_id: ras_output or hms_excess_precip (merged per event)
    %%   - storm_id: observed_precip (computed at runtime for events)

    grid_repos ||--o{ grids : ""
    events ||--o{ grids : ""

    grid_repos {
        repo_id int PK
        description str "Description of this Icechunk repo and its contents"
        domain enum "observed_meteorology || ras_output || hms_excess_precip"
        uri str "Icechunk repo location, e.g. s3://bucket/path"
        crs str
        created_at datetime
        metadata uri
    }

    grids {
        grid_id int PK
        repo_id int FK
        event_id int FK "Populated for ras_output, hms_excess_precip; null for observed_meteorology"
        variable str "depth || velocity || excess_precip || precip || temperature || etc."
        array_path str "Array/group name within the shared repo"
        snapshot_id str "Icechunk snapshot/commit id (or tag) pinning the version"
        units str
        nodata_value float
        created_at datetime
        metadata uri
    }

    events {
    }
