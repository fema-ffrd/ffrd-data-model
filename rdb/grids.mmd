---
title: Grids
---

erDiagram
    %% Gridded (raster) data lives in long-lived Icechunk repositories,
    %% one per data domain. Two tables catalog grid metadata and pointers.
    %% Spatial metadata (crs, resolution, extent) belongs in grid_repos.

    grid_repos ||--o{ observed_grids : ""
    grid_repos ||--o{ output_grids : ""
    storms ||--o{ observed_grids : ""
    events ||--o{ output_grids : ""

    grid_repos {
        repo_id int PK
        domain enum "ras_output | hms_excess_precip | observed_precip"
        uri str "Icechunk repo location, e.g. s3://bucket/path"
        description str
        crs str
        resolution float
        created_at datetime
    }

    observed_grids {
        observed_grid_id int PK
        repo_id int FK
        storm_id int FK
        variable str "precip || temp"
        array_path str "array/group name within the shared repo"
        snapshot_id str "Icechunk snapshot/commit id (or tag)"
        time_start datetime
        time_end datetime
    }

    output_grids {
        output_grid_id int PK
        repo_id int FK
        event_id int FK
        variable str "depth | velocity | excess_precip"
        array_path str "array/group name within the shared repo"
        snapshot_id str "Icechunk snapshot/commit id (or tag)"
    }

    events {
    }
    storms {
    }
